# hermes-home — copy to .env and fill in. NEVER commit .env.

# ---- Home Assistant ----------------------------------------------------
# Base URL of your Home Assistant instance, including scheme and port.
# Note: some HAOS installs serve on port 80, others on 8123 — check yours.
# An IP address works too; keep it here, never in committed files.
HOME_ASSISTANT_URL=http://homeassistant.local
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens
HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token
HOME_ASSISTANT_TIMEOUT_SECONDS=10

# ---- Webhook -----------------------------------------------------------
# Shared secret sent by the HA automation as the X-Hermes-Webhook-Secret header.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-a-long-random-string
WEBHOOK_MAX_BODY_BYTES=65536

# ---- Vision ------------------------------------------------------------
# One provider for every camera: "mock" (default, no credentials), "anthropic"
# (needs ANTHROPIC_API_KEY), or "ollama" (a local model; no key). There is no
# fallback between them -- if the selected one fails, the analysis is recorded
# as failed and the event is kept.
VISION_PROVIDER=mock
# Anthropic: a Claude model. Ollama: an installed local VISION model, e.g.
# gemma4:31b -- startup refuses a claude-* name with VISION_PROVIDER=ollama.
VISION_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Total deadline for ONE analysis attempt (the pipeline makes at most two).
# For Ollama this includes queueing behind other clients and a cold load.
VISION_TIMEOUT_SECONDS=30
# Images are analyzed then discarded. Retention is a future feature.
VISION_RETAIN_IMAGES=false

# ---- Ollama (read only when VISION_PROVIDER=ollama) ---------------------
# Native API base, never /v1. From the container: host.docker.internal.
# Natively: http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Context and output budget for the camera request only (not Ollama-wide).
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
# omit | true | false. "false" for a thinking-capable model (gemma4 is);
# "omit" for a model without the thinking capability, which rejects the flag.
OLLAMA_THINK=omit
# Per-request keep_alive (e.g. 30m). Empty = Ollama's own default (5m).
OLLAMA_KEEP_ALIVE=
#
# Recommended starting values when switching to Ollama (measure, then adjust):
#   VISION_PROVIDER=ollama
#   VISION_MODEL=gemma4:31b
#   OLLAMA_THINK=false
#   OLLAMA_KEEP_ALIVE=30m
#   VISION_TIMEOUT_SECONDS=90
#   INGEST_LEASE_SECONDS=300   # must exceed 15 + 2x90 + 2 + 15 = 212s; enforced
#   INGEST_WORKER_CONCURRENCY=1

# ---- Ingest worker -----------------------------------------------------
# How long to wait for the camera's event still to appear before giving up.
# attempts x interval; Eufy takes ~4s in practice, so 15s leaves good margin.
FRESHNESS_POLL_ATTEMPTS=15
FRESHNESS_POLL_INTERVAL_SECONDS=1.0
FRESHNESS_TOLERANCE_SECONDS=5.0

# How long shutdown waits for an in-flight job before cancelling it.
SHUTDOWN_GRACE_SECONDS=30

INGEST_WORKER_CONCURRENCY=1
INGEST_MAX_ATTEMPTS=5
INGEST_LEASE_SECONDS=120
DEDUPE_WINDOW_SECONDS=15
CORRELATION_WINDOW_SECONDS=120

# An incident stays open while it could still receive another correlated event.
# Once idle this long it is closed and given a deterministic summary.
INCIDENT_IDLE_SECONDS=120
INCIDENT_SWEEP_INTERVAL_SECONDS=60

# ---- Camera health -----------------------------------------------------
# Polls Home Assistant for camera availability so "no events in the backyard"
# can be distinguished from "the backyard camera was offline". Reads entity
# state only -- never an image.
#
# Turning this off does not make coverage answers optimistic: unmonitored
# periods report as UNKNOWN, never as covered.
CAMERA_HEALTH_ENABLED=true
CAMERA_HEALTH_INTERVAL_SECONDS=60
# Consecutive failed polls before the *current* status flips, so one dropped
# request does not announce an outage. History is never debounced: a single
# observed failure is recorded and will show up in historical coverage.
CAMERA_HEALTH_FAILURE_THRESHOLD=2

# ---- Delivery reconciliation -------------------------------------------
# Camera health says the camera was working. This says Home Assistant's events
# actually reached us -- a different failure, which has already happened here
# on its own: four triggers fired while every camera was healthy and all four
# deliveries were lost in transit, and nothing noticed.
#
# Compares HA's recorder history for each camera's trigger entity against the
# deliveries we received. Reads state history only; never an image.
DELIVERY_RECONCILIATION_ENABLED=true
DELIVERY_RECONCILIATION_INTERVAL_SECONDS=300
# Each pass re-examines this far back. Must exceed the interval so a slow or
# skipped pass leaves no unexamined hole.
DELIVERY_RECONCILIATION_LOOKBACK_SECONDS=3600
# Grace before a trigger counts as missing. Matching is on the time the webhook
# was RECEIVED, so this only has to cover Home Assistant -> webhook transit;
# a slow vision provider does not need it raised.
DELIVERY_SETTLE_SECONDS=90
DELIVERY_MATCH_WINDOW_SECONDS=30

# ---- Retention ---------------------------------------------------------
# Raw webhook bodies are nulled after this many days; the delivery row itself
# (timestamps, status, disposition) is kept permanently.
DELIVERY_RAW_RETENTION_DAYS=14

# ---- Service -----------------------------------------------------------
# Bind to loopback by default. Use 0.0.0.0 only inside Docker, where the
# compose port mapping controls actual exposure.
# MCP endpoint Host allowlist; localhost is always permitted.
# Add a LAN address only if an MCP client connects across the network.
MCP_ALLOWED_HOSTS=

# Host address Docker publishes the LAN port on, so Home Assistant can reach the
# webhook. Docker binds only this and 127.0.0.1 -- never 0.0.0.0.
# REQUIRED: set this to THIS machine's LAN address. Find it with:
#     macOS   ipconfig getifaddr en0
#     Linux   hostname -I | awk '{print $1}'
# Left blank on purpose so a fresh clone fails loudly instead of binding
# somewhere unintended.
LAN_BIND_IP=
HOST_PORT=8099

# Bind inside the process. Docker overrides this to 0.0.0.0 (safe: the container
# namespace is private). For a native run it is the real exposure.
HOST=127.0.0.1
PORT=8099
DATABASE_URL=sqlite+aiosqlite:///./data/hermes-home.db
LOG_LEVEL=INFO
LOG_FORMAT=console
DISPLAY_TIMEZONE=America/Los_Angeles
